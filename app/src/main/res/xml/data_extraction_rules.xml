<?xml version="1.0" encoding="utf-8"?><!--
   Aturan ekstraksi data untuk Android 12+ (API 31+).
   Aplikasi ini tidak menyimpan data apa pun ke disk (semua dummy & in-memory),
   jadi tidak ada yang perlu di-include atau di-exclude.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup />
    <device-transfer />
</data-extraction-rules>